# Copie para .env e ajuste:  cp .env.example .env

# Gere uma chave com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria

# Senha do PostgreSQL local (docker-compose)
POSTGRES_PASSWORD=troque-esta-senha

# Porta no seu computador (a 8000 é do Master Obra e a 8001 do servidor de desenvolvimento)
NINHO_PORTA=8002

# Endereços pelos quais o sistema será acessado (separe por vírgula)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8002,http://127.0.0.1:8002

# 1 quando estiver atrás de um proxy com HTTPS
DJANGO_HTTPS=0
